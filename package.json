{
  "name": "jonathan-febraio-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/generate-static-routes.mjs && npm run privacy:check",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "preview": "vite preview",
    "preview:pages": "node scripts/serve-pages.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "qa:capture": "node scripts/capture-v31-motion.mjs",
    "assets:optimize": "node scripts/optimize-images.mjs",
    "privacy:check": "node scripts/check-public-privacy.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@vitejs/plugin-react": "latest",
    "gsap": "^3.15.0",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "^7.18.3",
    "vite": "latest"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "latest",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "jsdom": "^26.1.0",
    "prettier": "latest",
    "sharp": "^0.35.4",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vitest": "^4.1.11"
  }
}
